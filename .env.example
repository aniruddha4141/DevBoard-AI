# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/devboard_ai"

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# AI (optional - mock fallback used if not set)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Encryption key for GitHub tokens (32 chars)
ENCRYPTION_SECRET="your-32-character-encryption-key"
